],["E:articles/Enish_Location_Illustrations_Lewisham.png","illustration","venue","lewisham","Enish Lewisham","art:lewisham"],["E:articles/Enish_Location_Illustrations_Manchester_6ee6f597-c650-40b7-b548-57cdad28711e.png","illustration","venue","manchester","Enish Manchester","art:manchester"],["E:articles/Enish_Location_Illustrations_Old_Kent_Road.png","illustration","venue","old-kent-road","Enish Old Kent Road","art:old-kent-road"],["E:articles/Enish_Location_Illustrations_Ocford_Street_b5b12d1b-5acd-4c78-a0e0-009f75a73d73.png","illustration","venue","oxford-street","Enish Oxford Street","art:oxford-street"],["E:articles/137c544b-24ab-4235-b8a5-46e5212fcd30_5539717b-565d-4eba-bd5e-9c01da7bfdc4.jpg","photo","venue","soho","Enish Soho Edition","photo:soho"],["E:articles/f1d79c3b-1adf-4d38-a542-69d3709823b4_d044f4db-afa4-4b86-9c62-d7316d441601.jpg","photo","venue","shoreditch","Enish Shoreditch","photo:shoreditch"],["E:files/PHOTO-2025-07-29-19-57-56_20.jpg","photo","happening",null,"Nights at Enish","home:PHOTO-2025-07-29-19-57-56_20.jpg"],["E:files/Enish_Glasgow.jpg","photo","happening","glasgow","Enish Glasgow","home:Enish_Glasgow.jpg"],["E:files/creation_2299214819.jpg","photo","happening",null,"The Enish table","home:creation_2299214819.jpg"],["E:files/Enish_Experiences-09.png","photo","experience",null,"Enish Experience","home:Enish_Experiences-09.png"],["E:files/Enish_Experiences-10.png","photo","experience",null,"Enish Experience","home:Enish_Experiences-10.png"],["E:files/Enish_Experiences-11.png","photo","experience",null,"Enish Experience","home:Enish_Experiences-11.png"],["E:files/Enish_Experiences-12.png","photo","experience",null,"Enish Experience","home:Enish_Experiences-12.png"],["E:files/Enish_Experiences-13.png","photo","experience",null,"Enish Experience","home:Enish_Experiences-13.png"],["E:files/Enish_Experiences-14.png","photo","experience",null,"Enish Experience","home:Enish_Experiences-14.png"],["E:files/Enish_Logo_2x_e8af47f6-bf12-4398-b3f7-be29eca14284.png","illustration","brand",null,"Enish logo","brand:logo"],["E:files/Enish_Icon_Light_2x_4bc1da52-2a69-4d5f-be9e-0b60f368b82f.png","illustration","brand",null,"Enish icon","brand:icon"],["E:files/Enish_Website_Background_Pattern-04.png","illustration","brand",null,"Pattern oxblood","brand:pattern-04"],["E:files/Enish_Website_Background_Pattern-05.png","illustration","brand",null,"Pattern 05","brand:pattern-05"]];

function sourceUrl(ref: string): string {
  return ref.startsWith("S:") ? S + ref.slice(2) : E + ref.slice(2);
}

function slug(sourceRef: string): string {
  return sourceRef.replace(/^[a-z]+:/, "").toLowerCase()
    .replace(/\.[a-z0-9]+$/, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}

Deno.serve(async (req: Request) => {
  const { offset = 0, limit = 15 } = await req.json().catch(() => ({}));
  const supabase = createClient(
    Deno.env.get("SUPABASE_URL")!,
    Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!,
  );
  const batch = ITEMS.slice(offset, offset + Math.min(limit, 25));
  const results: unknown[] = [];

  for (const [i, [ref, kind, category, venue, title, sourceRef]] of batch.entries()) {
    try {
      const width = kind === "illustration" ? 2000 : 1600;
      const res = await fetch(`${sourceUrl(ref)}?width=${width}`, {
        headers: { Accept: "image/jpeg,image/png;q=0.9" },
      });
      if (!res.ok) throw new Error(`fetch ${res.status}`);
      const type = (res.headers.get("content-type") ?? "image/jpeg").split(";")[0];
      const ext = type.includes("png") ? "png" : type.includes("webp") ? "webp" : "jpg";
      const path = `${category}/${slug(sourceRef)}.${ext}`;
      const body = new Uint8Array(await res.arrayBuffer());

      const up = await supabase.storage.from("media")
        .upload(path, body, { contentType: type, upsert: true });
      if (up.error) throw up.error;

      const publicUrl = supabase.storage.from("media").getPublicUrl(path).data.publicUrl;
      const row = await supabase.from("media").upsert({
        kind, category, venue_code: venue, title,
        storage_path: path, public_url: publicUrl,
        source: "website", source_ref: sourceRef, sort_order: offset + i,
      }, { onConflict: "storage_path" });
      if (row.error) throw row.error;
      results.push({ ok: path, bytes: body.length });
    } catch (e) {
      results.push({ fail: sourceRef, error: String((e as Error)?.message ?? e) });
    }
  }

  return Response.json({ total: ITEMS.length, offset, processed: batch.length, results });
});
